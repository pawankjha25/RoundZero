# Round Zero V1 - locked stack. Copy to .env and fill in what you have. Every
# LLM provider falls back to a mock/rule-based path with no key set (see each
# provider file's docstring), so local dev works with zero keys there.
# SUPABASE_URL is the one exception - auth has no mock fallback, every
# request 401s/500s without it. See specs/001-ml-system-design-vertical-slice/
# plan.md for why each stack choice.

# Database - Supabase Postgres in production; any Postgres DSN works. Leave
# unset for local dev and apps/api/db.py falls back to SQLite (apps/api/roundzero.db).
DATABASE_URL=

# Supabase Auth (backend side) - Project Settings -> API -> Project URL. Used
# to verify access tokens against Supabase's public JWKS endpoint
# (<url>/auth/v1/.well-known/jwks.json) - see apps/api/deps.py. No shared
# secret needed: Supabase signs tokens with an asymmetric key (ES256) and only
# the public half is ever fetched, so key rotation on Supabase's side needs no
# backend redeploy. The frontend's Supabase URL/anon key live in
# apps/web/.env.local instead (NEXT_PUBLIC_* vars, read by the browser) - same
# project, same URL, just a separate copy since the browser can't read this file.
SUPABASE_URL=

# Live interviewer (Gemini 2.5 Flash) + evidence extraction (Gemini 2.5 Flash-Lite).
# aistudio.google.com -> Get API key. Unset -> MockLLMGateway (scripted, no network).
GEMINI_API_KEY=
ROUNDZERO_GEMINI_MODEL=gemini-3.6-flash

# Evaluator + report/improvement synthesis (GPT-5 mini) - deliberately a
# different vendor from the interviewer (CLAUDE.md decision 4).
# platform.openai.com -> API keys. Unset -> RuleBasedEvaluator (coverage-based,
# no network) and the rule-based primary-concern/improvement-plan synthesis.
OPENAI_API_KEY=
ROUNDZERO_OPENAI_MODEL=gpt-5-mini

# Legacy/optional - kept working via AnthropicGateway but not the locked V1
# default. Only used if GEMINI_API_KEY is unset and this is set.
ANTHROPIC_API_KEY=
ROUNDZERO_LLM_MODEL=claude-sonnet-4-5

# Realtime voice (Milestone 4 - not wired into the app yet). LiveKit Cloud
# project: cloud.livekit.io -> project -> Settings -> Keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT (Nova-3) + TTS (Aura-2), one vendor/key for both (Milestone 4 - not wired
# in yet). console.deepgram.com -> API Keys.
DEEPGRAM_API_KEY=

# App
# Comma-separated, case-insensitive - whoever logs in with a matching email gets
# the Admin tab (apps/api/deps.py::is_admin_email). Empty/unset = no admins.
ADMIN_EMAILS=
ENV=development

# --- World-model interviewer (specs/005-world-model-interviewer) ---
# Master switch for evidence tracking, path map, flip and retry (default 1).
ROUNDZERO_WM_ENABLED=1
# Adaptive follow-ups: off | shadow (log what the picker would ask, don't steer) | live.
# Keep shadow until Gate 2 passes (evals/world_model/run_simulation.py).
ROUNDZERO_WM_ADAPTIVE=shadow
# Flip rewrites on the report (needs OPENAI_API_KEY for the writer). Default 1.
ROUNDZERO_WM_FLIP=1
# Force tracking inline (1) or on a background thread (0). Unset = inline only
# for the no-key rule-based extractor.
ROUNDZERO_WM_SYNC=
# Gemini model for the evidence extractor / blind re-scorer - set to the
# Flash-Lite model name your key has. Unset = the interviewer's Gemini model.
ROUNDZERO_EXTRACTOR_MODEL=
